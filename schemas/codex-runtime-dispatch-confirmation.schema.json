{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-runtime-dispatch-confirmation.schema.json",
  "title": "C10 runtime dispatch confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmationSchemaVersion", "recordType", "dispatchId", "taskWindow", "subAgents"],
  "properties": {
    "confirmationSchemaVersion": { "const": "0.17.0" },
    "recordType": { "const": "C10_RUNTIME_CONFIRMATION" },
    "dispatchId": { "type": "string" },
    "taskWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "taskId", "runtimeTitle", "generation", "windowId", "runtimeThreadRef", "runtimeProjectId", "runtimeCwd", "environmentType", "associationMethod", "associationHandoffRefs", "modelControl", "permissionControl"],
      "properties": {
        "status": { "enum": ["CREATED", "REUSED"] },
        "taskId": { "type": "string" },
        "runtimeTitle": { "type": "string" },
        "generation": { "type": "integer", "minimum": 1 },
        "windowId": { "type": "string" },
        "runtimeThreadRef": { "type": "string" },
        "runtimeProjectId": { "type": ["string", "null"] },
        "projectAssociationEvidence": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "creation", "threadReadback", "savedProject"],
          "properties": {
            "method": {"const": "NATIVE_CREATION_AND_GIT_COMMON_DIR"},
            "creation": {"$ref": "#/$defs/nativeEvidenceFile"},
            "threadReadback": {"$ref": "#/$defs/nativeEvidenceFile"},
            "savedProject": {"$ref": "#/$defs/nativeEvidenceFile"}
          }
        },
        "runtimeCwd": { "type": "string" },
        "environmentType": { "enum": ["LOCAL", "WORKTREE"] },
        "associationMethod": { "enum": ["DIRECT", "LOCAL_BOOTSTRAP_TO_WORKTREE", "EXISTING_REGISTERED_WINDOW"] },
        "associationHandoffRefs": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "modelControl": { "$ref": "#/$defs/windowModelControl" },
        "permissionControl": { "$ref": "#/$defs/windowPermissionControl" }
      },
      "allOf": [
        {
          "if": {"properties": {"runtimeProjectId": {"enum": [null, ""]}}},
          "then": {"required": ["projectAssociationEvidence"]}
        },
        {
          "if": { "properties": { "associationMethod": { "const": "LOCAL_BOOTSTRAP_TO_WORKTREE" } } },
          "then": { "properties": { "associationHandoffRefs": { "minItems": 1, "maxItems": 1 } } },
          "else": { "properties": { "associationHandoffRefs": { "maxItems": 0 } } }
        }
      ]
    },
    "subAgents": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subAgentId", "status", "runtimeAgentRef", "modelControl", "permissionControl"],
        "properties": {
          "subAgentId": { "type": "string" },
          "status": { "const": "CREATED" },
          "runtimeAgentRef": { "type": "string" },
          "modelControl": { "$ref": "#/$defs/subAgentModelControl" },
          "permissionControl": { "$ref": "#/$defs/subAgentPermissionControl" }
        }
      }
    }
  },
  "$defs": {
    "nativeEvidenceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "source", "extraction"],
      "properties": {
        "file": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
          "properties": {
            "file": {"type": "string", "pattern": "^/"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "extraction": {"type": "object", "minProperties": 1, "additionalProperties": {
          "oneOf": [
            {"type": "string", "pattern": "^/"},
            {"type": "object", "additionalProperties": false, "required": ["pointer", "absentAsNull"], "properties": {"pointer": {"type": "string", "pattern": "^/"}, "absentAsNull": {"const": true}}}
          ]
        }}
      }
    },
    "windowModelControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "method", "evidenceRef"],
      "properties": {
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$", "not": { "enum": ["UNKNOWN", "UNVERIFIED", "DEFAULT", "NONE"] } },
        "method": { "enum": ["NATIVE_CREATE_THREAD_MODEL_PARAMETER", "NATIVE_SEND_MESSAGE_MODEL_OVERRIDE", "MANUAL_UI_TERRA_SELECTION_EVIDENCE", "MANUAL_UI_MODEL_SELECTION_EVIDENCE", "RUNTIME_MODEL_READBACK"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "subAgentModelControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "method", "evidenceRef"],
      "properties": {
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$", "not": { "enum": ["UNKNOWN", "UNVERIFIED", "DEFAULT", "NONE"] } },
        "method": { "const": "NATIVE_SPAWN_AGENT_MODEL_PARAMETER" },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "windowPermissionControl": {
      "oneOf": [
        { "$ref": "#/$defs/windowFullAccessPermissionControl" },
        { "$ref": "#/$defs/windowScopedPermissionControl" }
      ]
    },
    "subAgentPermissionControl": {
      "oneOf": [
        { "$ref": "#/$defs/subAgentFullAccessPermissionControl" },
        { "$ref": "#/$defs/subAgentScopedPermissionControl" }
      ]
    },
    "windowFullAccessPermissionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionClass", "profile", "method", "evidenceRef", "writableRoots", "governanceDataRootAccess"],
      "properties": {
        "permissionClass": { "const": "FULL_ACCESS" },
        "profile": { "enum": ["full-access", ":danger-full-access", "danger-full-access", "disabled"] },
        "method": { "enum": ["PERMISSION_PROFILE_READBACK", "LEGACY_WORKSPACE_SANDBOX_READBACK", "MANUAL_UI_PERMISSION_EVIDENCE"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "writableRoots": { "type": "array", "maxItems": 0 },
        "governanceDataRootAccess": { "const": "NOT_RESTRICTED" }
      }
    },
    "windowScopedPermissionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionClass", "profile", "method", "evidenceRef", "writableRoots", "governanceDataRootAccess"],
      "properties": {
        "permissionClass": { "const": "WORKTREE_SCOPED" },
        "profile": { "enum": [":workspace"] },
        "method": { "enum": ["PERMISSION_PROFILE_READBACK", "LEGACY_WORKSPACE_SANDBOX_READBACK", "MANUAL_UI_PERMISSION_EVIDENCE"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "writableRoots": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "governanceDataRootAccess": { "const": "DENIED" }
      }
    },
    "subAgentFullAccessPermissionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionClass", "profile", "method", "evidenceRef", "writableRoots", "governanceDataRootAccess"],
      "properties": {
        "permissionClass": { "const": "FULL_ACCESS" },
        "profile": { "enum": ["full-access", ":danger-full-access", "danger-full-access", "disabled"] },
        "method": { "enum": ["INHERITED_FROM_PARENT_WINDOW", "SUB_AGENT_PERMISSION_READBACK"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "writableRoots": { "type": "array", "maxItems": 0 },
        "governanceDataRootAccess": { "const": "NOT_RESTRICTED" }
      }
    },
    "subAgentScopedPermissionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionClass", "profile", "method", "evidenceRef", "writableRoots", "governanceDataRootAccess"],
      "properties": {
        "permissionClass": { "const": "WORKTREE_SCOPED" },
        "profile": { "enum": [":workspace"] },
        "method": { "enum": ["INHERITED_FROM_PARENT_WINDOW", "SUB_AGENT_PERMISSION_READBACK"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "writableRoots": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "governanceDataRootAccess": { "const": "DENIED" }
      }
    }
  }
}
