{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-runtime-dispatch-confirmation.schema.json",
  "title": "C10 runtime dispatch confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmationSchemaVersion", "recordType", "dispatchId", "taskWindow", "subAgents"],
  "properties": {
    "confirmationSchemaVersion": { "const": "0.16.0" },
    "recordType": { "const": "C10_RUNTIME_CONFIRMATION" },
    "dispatchId": { "type": "string" },
    "taskWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "taskId", "runtimeTitle", "generation", "windowId", "runtimeThreadRef", "runtimeProjectId", "runtimeCwd", "environmentType", "associationMethod", "associationHandoffRefs", "modelControl"],
      "properties": {
        "status": { "enum": ["CREATED", "REUSED"] },
        "taskId": { "type": "string" },
        "runtimeTitle": { "type": "string" },
        "generation": { "type": "integer", "minimum": 1 },
        "windowId": { "type": "string" },
        "runtimeThreadRef": { "type": "string" },
        "runtimeProjectId": { "type": "string" },
        "runtimeCwd": { "type": "string" },
        "environmentType": { "enum": ["LOCAL", "WORKTREE"] },
        "associationMethod": { "enum": ["DIRECT", "LOCAL_HANDOFF_ROUNDTRIP"] },
        "associationHandoffRefs": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "modelControl": { "$ref": "#/$defs/windowModelControl" }
      },
      "allOf": [
        {
          "if": { "properties": { "associationMethod": { "const": "DIRECT" } } },
          "then": { "properties": { "associationHandoffRefs": { "maxItems": 0 } } },
          "else": { "properties": { "associationHandoffRefs": { "minItems": 2, "maxItems": 2 } } }
        }
      ]
    },
    "subAgents": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subAgentId", "status", "runtimeAgentRef", "modelControl"],
        "properties": {
          "subAgentId": { "type": "string" },
          "status": { "const": "CREATED" },
          "runtimeAgentRef": { "type": "string" },
          "modelControl": { "$ref": "#/$defs/subAgentModelControl" }
        }
      }
    }
  },
  "$defs": {
    "windowModelControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "method", "evidenceRef"],
      "properties": {
        "model": { "const": "gpt-5.6-terra" },
        "method": { "enum": ["NATIVE_CREATE_THREAD_MODEL_PARAMETER", "NATIVE_SEND_MESSAGE_MODEL_OVERRIDE", "MANUAL_UI_TERRA_SELECTION_EVIDENCE"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "subAgentModelControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "method", "evidenceRef"],
      "properties": {
        "model": { "const": "gpt-5.6-terra" },
        "method": { "const": "NATIVE_SPAWN_AGENT_MODEL_PARAMETER" },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
