{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-dispatch-request.schema.json",
  "title": "C10 dispatch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatchSchemaVersion", "recordType", "dispatchId", "projectId", "packageId", "reviewId", "taskId", "runtimeProject", "bossDispatchAuthorization", "subAgents"],
  "properties": {
    "dispatchSchemaVersion": { "const": "0.16.0" },
    "recordType": { "const": "C10_DISPATCH_REQUEST" },
    "dispatchId": { "type": "string" },
    "projectId": { "type": "string" },
    "packageId": { "type": "string" },
    "reviewId": { "type": "string" },
    "taskId": { "type": "string" },
    "runtimeProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codexProjectId", "projectPath", "isGitRepository", "environment"],
      "properties": {
        "codexProjectId": { "type": "string" },
        "projectPath": { "type": "string" },
        "isGitRepository": { "type": "boolean" },
        "environment": { "enum": ["LOCAL", "WORKTREE"] }
      }
    },
    "bossDispatchAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference", "scope"],
      "properties": {
        "status": { "const": "APPROVED" },
        "reference": { "type": "string" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "scopeId", "scopeDigest", "waveId", "taskIds"],
          "properties": {
            "type": { "enum": ["SINGLE_TASK", "EXECUTION_MAP"] },
            "scopeId": { "type": "string" },
            "scopeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "waveId": { "type": "string" },
            "taskIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } }
          }
        }
      }
    },
    "subAgents": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subAgentId", "role", "level", "delegationReason", "executionMode", "scope"],
        "properties": {
          "subAgentId": { "type": "string" },
          "role": { "type": "string", "minLength": 1, "maxLength": 160 },
          "level": { "const": 1 },
          "delegationReason": { "enum": ["LARGE_MATERIALS", "INDEPENDENT_SCOPE", "INDEPENDENT_VERIFICATION", "CROSS_CHECK"] },
          "executionMode": { "enum": ["READ_ONLY", "ISOLATED_WORK", "INDEPENDENT_VALIDATION"] },
          "scope": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    }
  }
}
