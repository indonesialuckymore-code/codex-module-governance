{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-adjudication-request.schema.json",
  "title": "C07 adjudication request input",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestSchemaVersion", "recordType", "requestId", "projectId", "taskId", "windowId", "submittedBy", "question", "whyBossCannotDecide", "knownFacts", "unknowns", "impactedObjectRefs", "options", "noActionImpact", "requestedAdvice"],
  "properties": {
    "requestSchemaVersion": { "const": "0.7.0" },
    "recordType": { "const": "C07_ADJUDICATION_REQUEST_INPUT" },
    "requestId": { "type": "string" },
    "projectId": { "type": "string" },
    "taskId": { "type": "string" },
    "windowId": { "type": "string" },
    "submittedBy": { "type": "object" },
    "question": { "type": "string" },
    "whyBossCannotDecide": { "type": "string" },
    "knownFacts": { "type": "array", "minItems": 1, "maxItems": 20 },
    "unknowns": { "type": "array", "maxItems": 20 },
    "impactedObjectRefs": { "type": "array", "minItems": 1, "maxItems": 40 },
    "options": { "type": "array", "minItems": 2, "maxItems": 5 },
    "noActionImpact": { "type": "string" },
    "requestedAdvice": { "type": "string" }
  }
}
