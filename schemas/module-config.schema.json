{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/module-config.schema.json",
  "title": "Codex Module Governance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "models", "subAgentPolicy", "storage", "projectInitialization", "ledger", "occupancy", "validation", "adjudication", "recovery", "centralIntegration", "dispatch", "externalSkills", "naturalLanguageGateway", "publishing"],
  "properties": {
    "schemaVersion": { "const": "0.12.0" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central", "taskWindow", "subAgent"],
      "properties": {
        "central": { "const": "gpt-5.6-sol" },
        "taskWindow": { "const": "gpt-5.6-terra" },
        "subAgent": { "const": "gpt-5.6-terra" }
      }
    },
    "subAgentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentFirstLevel", "allowGrandchildren"],
      "properties": {
        "maxConcurrentFirstLevel": { "const": 3 },
        "allowGrandchildren": { "const": false }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userDataRoot"],
      "properties": {
        "userDataRoot": { "type": "string", "minLength": 1 }
      }
    },
    "projectInitialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireExplicitApply", "denyGitWorktrees"],
      "properties": {
        "requireExplicitApply": { "const": true },
        "denyGitWorktrees": { "const": true }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "allowCrossModuleDetailedWrites", "allowTaskWindowDirectWrites", "allowSubAgentDirectWrites"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "allowCrossModuleDetailedWrites": { "const": false },
        "allowTaskWindowDirectWrites": { "const": false },
        "allowSubAgentDirectWrites": { "const": false }
      }
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "requireBossReview", "atomicReservation", "allowParallelSharedRead", "dispatchOnEligible"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "requireBossReview": { "const": true },
        "atomicReservation": { "const": true },
        "allowParallelSharedRead": { "const": true },
        "dispatchOnEligible": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "requireBossHandbackAuthorization", "requireIndependentReadback", "requireBossFinalApprovalForDone", "releaseOccupancyOnDone"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "requireBossHandbackAuthorization": { "const": true },
        "requireIndependentReadback": { "const": true },
        "requireBossFinalApprovalForDone": { "const": true },
        "releaseOccupancyOnDone": { "const": false }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "advisor", "adviceReturnsToBossOnly", "requireBossDecisionBeforeWindowHandoff", "allowAdviceToChangeTaskState", "allowAutomaticExecution"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "advisor": { "const": "central-background-advisor" },
        "adviceReturnsToBossOnly": { "const": true },
        "requireBossDecisionBeforeWindowHandoff": { "const": true },
        "allowAdviceToChangeTaskState": { "const": false },
        "allowAutomaticExecution": { "const": false }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "freezeBlocksNonRecoveryWrites", "releaseOccupancyOnDisconnect", "requireBossAuthorizationForTakeover", "takeoverResumesBusinessExecution", "requireC06ForDoneRelease", "requireSeparateBossReleaseAuthorization"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "freezeBlocksNonRecoveryWrites": { "const": true },
        "releaseOccupancyOnDisconnect": { "const": false },
        "requireBossAuthorizationForTakeover": { "const": true },
        "takeoverResumesBusinessExecution": { "const": false },
        "requireC06ForDoneRelease": { "const": true },
        "requireSeparateBossReleaseAuthorization": { "const": true }
      }
    },
    "centralIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleEntrySkill", "requireVerifiedLedgerBeforeRouting", "recoveryOverridesNormalRouting", "requireDownstreamGates", "allowDirectBusinessExecution", "actualDispatchAvailable"],
      "properties": {
        "soleEntrySkill": { "const": "central-construction-controller" },
        "requireVerifiedLedgerBeforeRouting": { "const": true },
        "recoveryOverridesNormalRouting": { "const": true },
        "requireDownstreamGates": { "const": true },
        "allowDirectBusinessExecution": { "const": false },
        "actualDispatchAvailable": { "const": true }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireTwoPhaseRuntimeConfirmation", "greenSharedReadParallel", "yellowIsolatedWriteAllowed", "redConflictHardStop", "subAgentsReturnToParentWindowOnly", "allowSubAgentDoneDeclaration"],
      "properties": {
        "requireTwoPhaseRuntimeConfirmation": { "const": true },
        "greenSharedReadParallel": { "const": true },
        "yellowIsolatedWriteAllowed": { "const": true },
        "redConflictHardStop": { "const": true },
        "subAgentsReturnToParentWindowOnly": { "const": true },
        "allowSubAgentDoneDeclaration": { "const": false }
      }
    },
    "externalSkills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "requireVersionPin", "requireLicenseReview", "requireBossActivationApproval", "allowAutomaticInstall", "allowProtocolMutation", "optionalMissingDisablesOnlyFeature"],
      "properties": {
        "protocol": { "const": "codex-governance-protocol-v1" },
        "requireVersionPin": { "const": true },
        "requireLicenseReview": { "const": true },
        "requireBossActivationApproval": { "const": true },
        "allowAutomaticInstall": { "const": false },
        "allowProtocolMutation": { "const": false },
        "optionalMissingDisablesOnlyFeature": { "const": true }
      }
    },
    "naturalLanguageGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrySkill", "centralSkill", "storeRawUtterance", "storeGatewayState", "requireSingleIntent", "requireTargetedApproval", "allowContextInferenceWhenUnique", "allowDirectDownstreamExecution"],
      "properties": {
        "entrySkill": { "const": "codex-governance-gateway" },
        "centralSkill": { "const": "central-construction-controller" },
        "storeRawUtterance": { "const": false },
        "storeGatewayState": { "const": false },
        "requireSingleIntent": { "const": true },
        "requireTargetedApproval": { "const": true },
        "allowContextInferenceWhenUnique": { "const": true },
        "allowDirectDownstreamExecution": { "const": false }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowRemotePublish"],
      "properties": {
        "mode": { "const": "private" },
        "allowRemotePublish": { "const": false }
      }
    }
  }
}
