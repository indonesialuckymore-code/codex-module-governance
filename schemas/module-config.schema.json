{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/module-config.schema.json",
  "title": "Codex Module Governance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "models", "runtimePermissions", "nativeRuntime", "subAgentPolicy", "storage", "projectInitialization", "ledger", "occupancy", "validation", "adjudication", "recovery", "centralIntegration", "dispatch", "externalSkills", "naturalLanguageGateway", "publishing"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "0.22.1" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central", "taskWindow", "subAgent"],
      "properties": {
        "central": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$", "not": { "enum": ["UNKNOWN", "UNVERIFIED", "DEFAULT", "NONE"] } },
        "taskWindow": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$", "not": { "enum": ["UNKNOWN", "UNVERIFIED", "DEFAULT", "NONE"] } },
        "subAgent": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$", "not": { "enum": ["UNKNOWN", "UNVERIFIED", "DEFAULT", "NONE"] } }
      }
    },
    "runtimePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultTaskWindowClass", "defaultTaskProfile", "subAgentPermissionMode", "allowedTaskProfiles", "forbidDangerFullAccess", "requireRuntimeEvidence", "restrictedModeOptional", "restrictedModeRequiresDeclaredWritableRoots", "restrictedModeDeniesGovernanceDataRootAccess", "allowManualUiEvidence", "autoReviewRequiresInteractiveApproval"],
      "properties": {
        "defaultTaskWindowClass": { "const": "FULL_ACCESS" },
        "defaultTaskProfile": { "const": "full-access" },
        "subAgentPermissionMode": { "const": "INHERIT_PARENT" },
        "allowedTaskProfiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["full-access", ":danger-full-access", "danger-full-access", ":workspace", "disabled"] },
          "allOf": [
            { "contains": { "const": "full-access" } },
            { "contains": { "const": ":danger-full-access" } },
            { "contains": { "const": "danger-full-access" } },
            { "contains": { "const": ":workspace" } }
          ]
        },
        "forbidDangerFullAccess": { "const": false },
        "requireRuntimeEvidence": { "const": true },
        "restrictedModeOptional": { "const": true },
        "restrictedModeRequiresDeclaredWritableRoots": { "const": true },
        "restrictedModeDeniesGovernanceDataRootAccess": { "const": true },
        "allowManualUiEvidence": { "const": true },
        "autoReviewRequiresInteractiveApproval": { "const": true }
      }
    },
    "nativeRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createThreadTool", "sendMessageTool", "readThreadTool", "waitThreadsTool", "forkThreadTool", "handoffThreadTool", "setTitleTool", "setPinnedTool", "setArchivedTool", "maxMonitoringBatch", "uiProjectionIsStateSource"],
      "properties": {
        "createThreadTool": { "const": "codex_app__create_thread" },
        "sendMessageTool": { "const": "codex_app__send_message_to_thread" },
        "readThreadTool": { "const": "codex_app__read_thread" },
        "waitThreadsTool": { "const": "codex_app__wait_threads" },
        "forkThreadTool": { "const": "codex_app__fork_thread" },
        "handoffThreadTool": { "const": "codex_app__handoff_thread" },
        "setTitleTool": { "const": "codex_app__set_thread_title" },
        "setPinnedTool": { "const": "codex_app__set_thread_pinned" },
        "setArchivedTool": { "const": "codex_app__set_thread_archived" },
        "maxMonitoringBatch": { "const": 8 },
        "uiProjectionIsStateSource": { "const": false }
      }
    },
    "subAgentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentFirstLevel", "allowGrandchildren", "proactiveDelegation", "allowInScopeDynamicAppend", "requireStructuredReturn", "requireParentQualityGate"],
      "properties": {
        "maxConcurrentFirstLevel": { "const": 3 },
        "allowGrandchildren": { "const": false },
        "proactiveDelegation": { "const": true },
        "allowInScopeDynamicAppend": { "const": true },
        "requireStructuredReturn": { "const": true },
        "requireParentQualityGate": { "const": true }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userDataRoot"],
      "properties": {
        "userDataRoot": { "type": "string", "minLength": 1 }
      }
    },
    "projectInitialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireExplicitApply", "denyGitWorktrees"],
      "properties": {
        "requireExplicitApply": { "const": true },
        "denyGitWorktrees": { "const": true }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "allowCrossModuleDetailedWrites", "allowTaskWindowDirectWrites", "allowSubAgentDirectWrites"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "allowCrossModuleDetailedWrites": { "const": false },
        "allowTaskWindowDirectWrites": { "const": false },
        "allowSubAgentDirectWrites": { "const": false }
      }
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "requireBossReview", "atomicReservation", "allowParallelSharedRead", "dispatchOnEligible"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "requireBossReview": { "const": true },
        "atomicReservation": { "const": true },
        "allowParallelSharedRead": { "const": true },
        "dispatchOnEligible": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "requireBossHandbackAuthorization", "requireIndependentReadback", "requireBossFinalApprovalForDone", "releaseOccupancyOnDone"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "requireBossHandbackAuthorization": { "const": true },
        "requireIndependentReadback": { "const": true },
        "requireBossFinalApprovalForDone": { "const": true },
        "releaseOccupancyOnDone": { "const": false }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "advisor", "adviceReturnsToBossOnly", "requireBossDecisionBeforeWindowHandoff", "allowAdviceToChangeTaskState", "allowAutomaticExecution"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "advisor": { "const": "central-background-advisor" },
        "adviceReturnsToBossOnly": { "const": true },
        "requireBossDecisionBeforeWindowHandoff": { "const": true },
        "allowAdviceToChangeTaskState": { "const": false },
        "allowAutomaticExecution": { "const": false }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleWriter", "freezeBlocksNonRecoveryWrites", "releaseOccupancyOnDisconnect", "requireBossAuthorizationForTakeover", "takeoverResumesBusinessExecution", "requireC06ForDoneRelease", "requireSeparateBossReleaseAuthorization"],
      "properties": {
        "soleWriter": { "const": "codex-module-central" },
        "freezeBlocksNonRecoveryWrites": { "const": true },
        "releaseOccupancyOnDisconnect": { "const": false },
        "requireBossAuthorizationForTakeover": { "const": true },
        "takeoverResumesBusinessExecution": { "const": false },
        "requireC06ForDoneRelease": { "const": true },
        "requireSeparateBossReleaseAuthorization": { "const": true }
      }
    },
    "centralIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soleEntrySkill", "requireVerifiedLedgerBeforeRouting", "recoveryOverridesNormalRouting", "requireDownstreamGates", "allowDirectBusinessExecution", "actualDispatchAvailable"],
      "properties": {
        "soleEntrySkill": { "const": "central-construction-controller" },
        "requireVerifiedLedgerBeforeRouting": { "const": true },
        "recoveryOverridesNormalRouting": { "const": true },
        "requireDownstreamGates": { "const": true },
        "allowDirectBusinessExecution": { "const": false },
        "actualDispatchAvailable": { "const": true }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireTwoPhaseRuntimeConfirmation", "allowPlanScopedBatchApproval", "releaseApprovedWavesWhenDependenciesDone", "requireSavedCodexProjectTarget", "newGitTaskProjectBinding", "rejectProjectlessTargets", "maxThreadsPerMonitoringBatch", "greenSharedReadParallel", "yellowIsolatedWriteAllowed", "redConflictHardStop", "subAgentsReturnToParentWindowOnly", "allowSubAgentDoneDeclaration", "parentMustReadCriticalEvidence", "noRawSubAgentOutputConcatenation"],
      "properties": {
        "requireTwoPhaseRuntimeConfirmation": { "const": true },
        "allowPlanScopedBatchApproval": { "const": true },
        "releaseApprovedWavesWhenDependenciesDone": { "const": true },
        "requireSavedCodexProjectTarget": { "const": true },
        "newGitTaskProjectBinding": { "enum": ["DIRECT_PROJECT_WORKTREE", "LOCAL_BOOTSTRAP_TO_WORKTREE"] },
        "rejectProjectlessTargets": { "const": true },
        "maxThreadsPerMonitoringBatch": { "const": 8 },
        "greenSharedReadParallel": { "const": true },
        "yellowIsolatedWriteAllowed": { "const": true },
        "redConflictHardStop": { "const": true },
        "subAgentsReturnToParentWindowOnly": { "const": true },
        "allowSubAgentDoneDeclaration": { "const": false },
        "parentMustReadCriticalEvidence": { "const": true },
        "noRawSubAgentOutputConcatenation": { "const": true }
      }
    },
    "externalSkills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "requireVersionPin", "requireLicenseReview", "requireBossActivationApproval", "allowAutomaticInstall", "allowProtocolMutation", "optionalMissingDisablesOnlyFeature"],
      "properties": {
        "protocol": { "const": "codex-governance-protocol-v1" },
        "requireVersionPin": { "const": true },
        "requireLicenseReview": { "const": true },
        "requireBossActivationApproval": { "const": true },
        "allowAutomaticInstall": { "const": false },
        "allowProtocolMutation": { "const": false },
        "optionalMissingDisablesOnlyFeature": { "const": true }
      }
    },
    "naturalLanguageGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrySkill", "centralSkill", "storeRawUtterance", "storeGatewayState", "requireSingleIntent", "requireTargetedApproval", "allowContextInferenceWhenUnique", "allowDirectDownstreamExecution"],
      "properties": {
        "entrySkill": { "const": "codex-governance-gateway" },
        "centralSkill": { "const": "central-construction-controller" },
        "storeRawUtterance": { "const": false },
        "storeGatewayState": { "const": false },
        "requireSingleIntent": { "const": true },
        "requireTargetedApproval": { "const": true },
        "allowContextInferenceWhenUnique": { "const": true },
        "allowDirectDownstreamExecution": { "const": false }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowRemotePublish"],
      "properties": {
        "mode": { "const": "private" },
        "allowRemotePublish": { "const": false }
      }
    }
  }
}
