{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-role-handover-request.schema.json",
  "title": "C08 logical-role handover request",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoverSchemaVersion", "recordType", "handoverId", "projectId", "role", "mode", "reasonRef", "executionMapRef", "contextRefs", "nextExpectedSignals"],
  "properties": {
    "handoverSchemaVersion": { "const": "0.15.0" },
    "recordType": { "const": "C08_ROLE_HANDOVER_REQUEST" },
    "handoverId": { "type": "string" },
    "projectId": { "type": "string" },
    "role": { "enum": ["CURRENT_CENTRAL", "CURRENT_ADJUDICATION"] },
    "mode": { "enum": ["REPLACE_ACTIVE_ROLE", "BOOTSTRAP_ADJUDICATION_FROM_CENTRAL"] },
    "reasonRef": { "type": "string" },
    "executionMapRef": { "type": "string" },
    "contextRefs": { "type": "array", "minItems": 1, "maxItems": 80, "uniqueItems": true, "items": { "type": "string" } },
    "nextExpectedSignals": { "type": "array", "maxItems": 80, "uniqueItems": true, "items": { "type": "string" } }
  }
}
