{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/projects-index.schema.json",
  "title": "C02 project startup index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "createdAt", "updatedAt", "projects"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "recordType": { "const": "C02_PROJECT_STARTUP_INDEX" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "displayName", "normalizedDisplayName", "createdAt", "state"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "normalizedDisplayName": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "state": { "const": "PROJECT_REGISTERED" }
        }
      }
    }
  }
}
