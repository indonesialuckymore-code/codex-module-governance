{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qianyi.local/schemas/codex-module-governance/codex-sub-agent-return.schema.json",
  "title": "C10 first-level sub-agent return",
  "type": "object",
  "additionalProperties": false,
  "required": ["returnSchemaVersion", "recordType", "dispatchId", "subAgentId", "returnId", "submittedToWindowId", "status", "scope", "confirmedFacts", "completedWork", "evidenceRefs", "unresolvedRefs", "scopeDeviation", "risksAndConflicts", "recommendedParentAction"],
  "properties": {
    "returnSchemaVersion": { "const": "0.17.0" },
    "recordType": { "const": "C10_SUB_AGENT_RETURN" },
    "dispatchId": { "type": "string" },
    "subAgentId": { "type": "string" },
    "returnId": { "type": "string" },
    "submittedToWindowId": { "type": "string" },
    "status": { "enum": ["NEEDS_REVIEW", "PARTIAL", "BLOCKED"] },
    "scope": { "type": "string", "minLength": 1, "maxLength": 600 },
    "confirmedFacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "completedWork": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "unresolvedRefs": { "type": "array", "items": { "type": "string" } },
    "scopeDeviation": { "type": "array", "items": { "type": "string" } },
    "risksAndConflicts": { "type": "array", "items": { "type": "string" } },
    "recommendedParentAction": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
