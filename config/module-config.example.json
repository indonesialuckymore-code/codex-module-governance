{
  "$schema": "../schemas/module-config.schema.json",
  "schemaVersion": "0.9.0",
  "module": {
    "id": "replace-with-module-id",
    "displayName": "Codex 模块"
  },
  "models": {
    "central": "gpt-5.6-sol",
    "taskWindow": "gpt-5.6-terra",
    "subAgent": "gpt-5.6-terra"
  },
  "subAgentPolicy": {
    "maxConcurrentFirstLevel": 3,
    "allowGrandchildren": false
  },
  "storage": {
    "userDataRoot": "replace-with-user-selected-private-directory"
  },
  "projectInitialization": {
    "requireExplicitApply": true,
    "denyGitWorktrees": true
  },
  "ledger": {
    "soleWriter": "codex-module-central",
    "allowCrossModuleDetailedWrites": false,
    "allowTaskWindowDirectWrites": false,
    "allowSubAgentDirectWrites": false
  },
  "occupancy": {
    "soleWriter": "codex-module-central",
    "requireBossReview": true,
    "atomicReservation": true,
    "allowParallelSharedRead": true,
    "dispatchOnEligible": false
  },
  "validation": {
    "soleWriter": "codex-module-central",
    "requireBossHandbackAuthorization": true,
    "requireIndependentReadback": true,
    "requireBossFinalApprovalForDone": true,
    "releaseOccupancyOnDone": false
  },
  "adjudication": {
    "soleWriter": "codex-module-central",
    "advisor": "central-background-advisor",
    "adviceReturnsToBossOnly": true,
    "requireBossDecisionBeforeWindowHandoff": true,
    "allowAdviceToChangeTaskState": false,
    "allowAutomaticExecution": false
  },
  "recovery": {
    "soleWriter": "codex-module-central",
    "freezeBlocksNonRecoveryWrites": true,
    "releaseOccupancyOnDisconnect": false,
    "requireBossAuthorizationForTakeover": true,
    "takeoverResumesBusinessExecution": false,
    "requireC06ForDoneRelease": true,
    "requireSeparateBossReleaseAuthorization": true
  },
  "centralIntegration": {
    "soleEntrySkill": "central-construction-controller",
    "requireVerifiedLedgerBeforeRouting": true,
    "recoveryOverridesNormalRouting": true,
    "requireDownstreamGates": true,
    "allowDirectBusinessExecution": false,
    "actualDispatchAvailable": false
  },
  "publishing": {
    "mode": "private",
    "allowRemotePublish": false
  }
}
