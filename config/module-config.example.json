{
  "$schema": "../schemas/module-config.schema.json",
  "schemaVersion": "0.22.1",
  "module": {
    "id": "replace-with-module-id",
    "displayName": "Codex 模块"
  },
  "models": {
    "central": "gpt-5.6-sol",
    "taskWindow": "gpt-5.6-terra",
    "subAgent": "gpt-5.6-terra"
  },
  "runtimePermissions": {
    "defaultTaskWindowClass": "FULL_ACCESS",
    "defaultTaskProfile": "full-access",
    "subAgentPermissionMode": "INHERIT_PARENT",
    "allowedTaskProfiles": ["full-access", ":danger-full-access", "danger-full-access", ":workspace"],
    "forbidDangerFullAccess": false,
    "requireRuntimeEvidence": true,
    "restrictedModeOptional": true,
    "restrictedModeRequiresDeclaredWritableRoots": true,
    "restrictedModeDeniesGovernanceDataRootAccess": true,
    "allowManualUiEvidence": true,
    "autoReviewRequiresInteractiveApproval": true
  },
  "nativeRuntime": {
    "createThreadTool": "codex_app__create_thread",
    "sendMessageTool": "codex_app__send_message_to_thread",
    "readThreadTool": "codex_app__read_thread",
    "waitThreadsTool": "codex_app__wait_threads",
    "forkThreadTool": "codex_app__fork_thread",
    "handoffThreadTool": "codex_app__handoff_thread",
    "setTitleTool": "codex_app__set_thread_title",
    "setPinnedTool": "codex_app__set_thread_pinned",
    "setArchivedTool": "codex_app__set_thread_archived",
    "maxMonitoringBatch": 8,
    "uiProjectionIsStateSource": false
  },
  "subAgentPolicy": {
    "maxConcurrentFirstLevel": 3,
    "allowGrandchildren": false,
    "proactiveDelegation": true,
    "allowInScopeDynamicAppend": true,
    "requireStructuredReturn": true,
    "requireParentQualityGate": true
  },
  "storage": {
    "userDataRoot": "replace-with-user-selected-private-directory"
  },
  "projectInitialization": {
    "requireExplicitApply": true,
    "denyGitWorktrees": true
  },
  "ledger": {
    "soleWriter": "codex-module-central",
    "allowCrossModuleDetailedWrites": false,
    "allowTaskWindowDirectWrites": false,
    "allowSubAgentDirectWrites": false
  },
  "occupancy": {
    "soleWriter": "codex-module-central",
    "requireBossReview": true,
    "atomicReservation": true,
    "allowParallelSharedRead": true,
    "dispatchOnEligible": false
  },
  "validation": {
    "soleWriter": "codex-module-central",
    "requireBossHandbackAuthorization": true,
    "requireIndependentReadback": true,
    "requireBossFinalApprovalForDone": true,
    "releaseOccupancyOnDone": false
  },
  "adjudication": {
    "soleWriter": "codex-module-central",
    "advisor": "central-background-advisor",
    "adviceReturnsToBossOnly": true,
    "requireBossDecisionBeforeWindowHandoff": true,
    "allowAdviceToChangeTaskState": false,
    "allowAutomaticExecution": false
  },
  "recovery": {
    "soleWriter": "codex-module-central",
    "freezeBlocksNonRecoveryWrites": true,
    "releaseOccupancyOnDisconnect": false,
    "requireBossAuthorizationForTakeover": true,
    "takeoverResumesBusinessExecution": false,
    "requireC06ForDoneRelease": true,
    "requireSeparateBossReleaseAuthorization": true
  },
  "centralIntegration": {
    "soleEntrySkill": "central-construction-controller",
    "requireVerifiedLedgerBeforeRouting": true,
    "recoveryOverridesNormalRouting": true,
    "requireDownstreamGates": true,
    "allowDirectBusinessExecution": false,
    "actualDispatchAvailable": true
  },
  "dispatch": {
    "requireTwoPhaseRuntimeConfirmation": true,
    "allowPlanScopedBatchApproval": true,
    "releaseApprovedWavesWhenDependenciesDone": true,
    "requireSavedCodexProjectTarget": true,
    "newGitTaskProjectBinding": "DIRECT_PROJECT_WORKTREE",
    "rejectProjectlessTargets": true,
    "maxThreadsPerMonitoringBatch": 8,
    "greenSharedReadParallel": true,
    "yellowIsolatedWriteAllowed": true,
    "redConflictHardStop": true,
    "subAgentsReturnToParentWindowOnly": true,
    "allowSubAgentDoneDeclaration": false,
    "parentMustReadCriticalEvidence": true,
    "noRawSubAgentOutputConcatenation": true
  },
  "externalSkills": {
    "protocol": "codex-governance-protocol-v1",
    "requireVersionPin": true,
    "requireLicenseReview": true,
    "requireBossActivationApproval": true,
    "allowAutomaticInstall": false,
    "allowProtocolMutation": false,
    "optionalMissingDisablesOnlyFeature": true
  },
  "naturalLanguageGateway": {
    "entrySkill": "codex-governance-gateway",
    "centralSkill": "central-construction-controller",
    "storeRawUtterance": false,
    "storeGatewayState": false,
    "requireSingleIntent": true,
    "requireTargetedApproval": true,
    "allowContextInferenceWhenUnique": true,
    "allowDirectDownstreamExecution": false
  },
  "publishing": {
    "mode": "private",
    "allowRemotePublish": false
  }
}
